name: QuailEgg Release
on:
  push:
    branches: ["[[ .BaseBranch ]]"]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  id-token: write

concurrency:
  group: qegg-release
  cancel-in-progress: false

jobs:
  release:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    if: github.actor != 'github-actions[bot]'
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
[[- range .EcosystemSetups ]]
[[ indent 6 . ]]
[[- end ]]
      - name: Install qegg
        run: go install github.com/SuperQuail/QuailEgg/cmd/qegg@[[ .QeggVersion ]]
      - name: Release
        run: qegg release --yes
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
[[- range .EcosystemEnvs ]]
[[ indent 10 . ]]
[[- end ]]
