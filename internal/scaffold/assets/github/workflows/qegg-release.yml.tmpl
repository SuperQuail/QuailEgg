name: QuailEgg Release
on:
  push:
    branches: ["[[ .BaseBranch ]]"]
    paths:
[[- range .ReleasePaths ]]
      - "[[ . ]]"
[[- end ]]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  id-token: write

concurrency:
  group: qegg-release
  cancel-in-progress: false

jobs:
[[- if .BuildJobs ]]
  plan:
    runs-on: [[ .Workflow.Runner ]]
    timeout-minutes: 15
    if: [[ .ActorGuard ]]
    outputs:
      phase: ${{ steps.plan.outputs.phase }}
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
      - name: Install qegg
        run: go install github.com/SuperQuail/QuailEgg/cmd/qegg@[[ .QeggVersion ]]
      - name: Plan
        id: plan
        shell: bash
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          qegg plan --json > "$RUNNER_TEMP/plan.json"
          phase="$(jq -r .phase "$RUNNER_TEMP/plan.json")"
          case "$phase" in
            none|version|publish) ;;
            *) echo "unexpected phase: $phase" >&2; exit 1 ;;
          esac
          echo "phase=$phase" >> "$GITHUB_OUTPUT"
[[- end ]]
[[- range .BuildJobs ]]
  build-[[ .ID ]]:
    needs: plan
    if: [[ $.BuildCondition ]]
    runs-on: [[ .Runner ]]
    timeout-minutes: [[ .Timeout ]]
[[- if .Env ]]
    env:
[[ indent 6 .Env ]]
[[- end ]]
    steps:
[[- if .YAML ]]
[[ indent 6 .YAML ]]
[[- else ]]
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
[[- range $.EcosystemSetups ]]
[[ indent 6 . ]]
[[- end ]]
[[- range .Steps ]]
      - run: [[ shquote . ]]
[[- end ]]
[[- end ]]
      - uses: actions/upload-artifact@v4
        with:
          name: qegg-assets-[[ .ID ]]
          if-no-files-found: error
          path: |
[[- range .Artifacts ]]
            [[ . ]]
[[- end ]]
[[- end ]]
[[- range .ReleaseJobs ]]
  [[ .Name ]]:
[[- if .Needs ]]
    needs:
[[- range .Needs ]]
      - [[ . ]]
[[- end ]]
[[- end ]]
    runs-on: [[ $.Workflow.Runner ]]
    timeout-minutes: [[ $.Workflow.TimeoutMinutes ]]
[[- if $.ReleaseEnv ]]
    env:
[[ indent 6 $.ReleaseEnv ]]
[[- end ]]
[[- if $.Environment ]]
    environment: [[ $.Environment ]]
[[- end ]]
    if: [[ .Condition ]]
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - name: Configure git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
[[- range $.EcosystemSetups ]]
[[ indent 6 . ]]
[[- end ]]
      - name: Install qegg
        run: go install github.com/SuperQuail/QuailEgg/cmd/qegg@[[ $.QeggVersion ]]
[[- if $.Workflow.YAML ]]
[[ indent 6 $.Workflow.YAML ]]
[[- else ]]
[[- range $.Workflow.Steps ]]
      - run: [[ shquote . ]]
[[- end ]]
[[- end ]]
[[- if .Downloads ]]
      - uses: actions/download-artifact@v4
        with:
          pattern: qegg-assets-*
          path: .quailegg/assets/downloaded
      - name: Release
        run: qegg release --yes --assets-dir .quailegg/assets/downloaded
[[- else ]]
      - name: Release
        run: qegg release --yes
[[- end ]]
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
[[- range $.EcosystemEnvs ]]
[[ indent 10 . ]]
[[- end ]]
[[- end ]]
