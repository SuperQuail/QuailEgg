name: QuailEgg PR
on:
  pull_request:
    types: [opened, synchronize, reopened]
    branches:
      - [[ yamlquote .BaseBranch ]]

permissions:
  contents: read
  pull-requests: read

concurrency:
  group: qegg-pr-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: [[ .PRWorkflow.Runner ]]
    timeout-minutes: [[ .PRWorkflow.TimeoutMinutes ]]
[[- if .PREnv ]]
    env:
[[ indent 6 .PREnv ]]
[[- end ]]
    if: [[ .PRCheckCondition ]]
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
[[- range .EcosystemSetups ]]
[[ indent 6 . ]]
[[- end ]]
[[ indent 6 .QeggSetup ]]
[[- if .PRWorkflow.YAML ]]
[[ indent 6 .PRWorkflow.YAML ]]
[[- else ]]
[[- range .PRWorkflow.Steps ]]
      - run: [[ shquote . ]]
[[- end ]]
[[- end ]]
      - name: Check
        run: qegg check --ci
      - name: Preview
        id: preview
        shell: bash
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          plan="$RUNNER_TEMP/plan.md"
          qegg plan --markdown > "$plan"
          if [ -s "$plan" ]; then
            echo "has_plan=true" >> "$GITHUB_OUTPUT"
          else
            echo "no pending release"
          fi

      - name: Upload release plan
        if: steps.preview.outputs.has_plan == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: qegg-pr-plan-${{ github.run_attempt }}
          path: ${{ runner.temp }}/plan.md
          if-no-files-found: error
          retention-days: 3
