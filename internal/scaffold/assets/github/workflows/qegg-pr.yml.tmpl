name: QuailEgg PR
on:
  pull_request:
    types: [opened, synchronize, reopened]
    branches: ["[[ .BaseBranch ]]"]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: qegg-pr-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: [[ .PRWorkflow.Runner ]]
    timeout-minutes: [[ .PRWorkflow.TimeoutMinutes ]]
[[- if .PREnv ]]
    env:
[[ indent 6 .PREnv ]]
[[- end ]]
    if: github.head_ref != '[[ .ReleaseBranch ]]'
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.26', cache: true }
[[- range .EcosystemSetups ]]
[[ indent 6 . ]]
[[- end ]]
[[ indent 6 .QeggSetup ]]
[[- if .PRWorkflow.YAML ]]
[[ indent 6 .PRWorkflow.YAML ]]
[[- else ]]
[[- range .PRWorkflow.Steps ]]
      - run: [[ shquote . ]]
[[- end ]]
[[- end ]]
      - name: Check
        run: qegg check --ci
      - name: Preview
        shell: bash
        run: |
          qegg plan --markdown > plan.md
          if [ -s plan.md ]; then
            gh pr comment ${{ github.event.pull_request.number }} --edit-last --create-if-none -F plan.md
          else
            echo "no pending release; skipping the plan comment"
          fi
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
